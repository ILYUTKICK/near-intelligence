# NEAR Intelligence — planned configuration contract; no real credentials.
# Load server values explicitly through API settings; never expose server values via NEXT_PUBLIC_.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://api:8000
# Native API development overrides API_INTERNAL_URL to http://localhost:8000.
DATABASE_URL=postgresql+psycopg://near_app:REPLACE_LOCAL_PASSWORD@localhost:5432/near_intelligence
# Migration/admin role is separate from the runtime application role.
MIGRATION_DATABASE_URL=postgresql+psycopg://near_migrator:REPLACE_LOCAL_PASSWORD@localhost:5432/near_intelligence
# Compose substitutes host db for localhost inside containers; production uses TLS.
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_PUBLIC_KEY
SUPABASE_JWT_ISSUER=https://REPLACE_PROJECT.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://REPLACE_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
# Set after verifying the provider's asymmetric signing configuration; reject other algorithms.
SUPABASE_JWT_ALGORITHM=ES256
AUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000
# Comma/space-separated list; must match the provider Site URL/redirect allowlist exactly.
# Independent high-entropy server secrets; generate locally (openssl rand -base64 32), never commit real values.
AUTH_COOKIE_SIGNING_SECRET=REPLACE_WITH_RANDOM_SERVER_SECRET
CSRF_SIGNING_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SERVER_SECRET
# Storage is a persistent local volume for MVP; archives referenced by relative artifact IDs.
ARTIFACT_ROOT=/var/lib/near-intelligence/artifacts
LOG_LEVEL=INFO
# Collectors remain off until provider/budget/permission gates are cleared.
INGESTION_ENABLED=false
INGESTION_SOURCE_ALLOWLIST=
NEAR_RPC_URL=
NEAR_ARCHIVAL_RPC_URL=
NEAR_RPC_API_KEY=
INTENTS_EXPLORER_BASE_URL=https://explorer.near-intents.org
INTENTS_EXPLORER_TOKEN=
DUNE_API_KEY=
DEFILLAMA_API_KEY=
COINGECKO_API_KEY=
# Optional future cloud ingestion: use workload identity, not embedded account-key JSON.
GCP_PROJECT_ID=
BIGQUERY_LOCATION=
BIGQUERY_MAX_BYTES_BILLED=0
# Configure per provider only after quotas are verified; 0 disables requests.
PROVIDER_REQUESTS_PER_MINUTE=0
PROVIDER_MAX_DAILY_REQUESTS=0
# No LLM, payment, wallet-signing, or trading credentials are required.
