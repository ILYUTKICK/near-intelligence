{
  "name": "near-intelligence",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Evidence-first NEAR investment research product (pnpm workspace root).",
  "scripts": {
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "test": "pnpm --filter web test",
    "build": "pnpm --filter web build",
    "check:contrast": "pnpm --filter web check:contrast",
    "check:client-secrets": "pnpm --filter web check:client-secrets",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "check:contracts": "node packages/shared-types/scripts/generate.mjs --check",
    "test:api:unit": "uv run --project apps/api python -m unittest discover -s apps/api/tests -p test_contracts.py -v && uv run --project apps/api python -m unittest discover -s apps/api/tests -p test_source_capabilities.py -v",
    "test:api:db": "uv run --project apps/api python scripts/run-db-tests.py --pg-bin /usr/lib/postgresql/18/bin"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
