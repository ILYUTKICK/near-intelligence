# Initialize secrets with env.py init --env-file <repository>/.env.vps
# --release-tag <UTC timestamp>-<audited source SHA256>. Never source this file.
# The helper accepts plain KEY=value lines and deliberately rejects interpolation.
RELEASE_TAG=REPLACE_AUDITED_RELEASE_TAG
# Official manifest-index digest verified2026-11-14; Apache2.0.
CADDY_IMAGE=caddy:2.11.9-alpine@sha256:003a97808e781aa9f7e75cc2f43d34d461099031faf5e20faefb9f61126836f0
APP_ENV=production
APP_ORIGIN=https://near-intelligence.me
API_INTERNAL_URL=http://api:8000
DB_BOOTSTRAP_PASSWORD=REPLACE_GENERATED_HEX_SECRET
DB_RUNTIME_PASSWORD=REPLACE_GENERATED_HEX_SECRET
DB_MIGRATION_PASSWORD=REPLACE_GENERATED_HEX_SECRET
DB_OPERATOR_PASSWORD=REPLACE_GENERATED_HEX_SECRET
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_PUBLIC_KEY
SUPABASE_JWT_ISSUER=https://REPLACE_PROJECT.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://REPLACE_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHM=ES256
AUTH_ALLOWED_REDIRECT_ORIGINS=https://near-intelligence.me
AUTH_COOKIE_SIGNING_SECRET=REPLACE_GENERATED_SECRET
CSRF_SIGNING_SECRET=REPLACE_GENERATED_SECRET
ARTIFACT_ROOT=/var/lib/near-intelligence/artifacts
LOG_LEVEL=INFO
# These remain disabled; this topology has no ingestion/refresh service.
INGESTION_ENABLED=false
INGESTION_SOURCE_ALLOWLIST=
BIGQUERY_MAX_BYTES_BILLED=0
PROVIDER_REQUESTS_PER_MINUTE=0
PROVIDER_MAX_DAILY_REQUESTS=0
