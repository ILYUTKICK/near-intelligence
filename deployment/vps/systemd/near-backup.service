[Unit]
Description=NEAR coherent local DB and artifact backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=near
Group=near
WorkingDirectory=/opt/near-intelligence
UMask=0077
ExecStart=/usr/bin/python3 /opt/near-intelligence/deployment/vps/backup_daily.py
TimeoutStartSec=1h
